# DATA_SOURCE=synthetic (default, no credentials) or kafka (live Darwin via Rail Data Marketplace)
DATA_SOURCE=synthetic
PORT=3000

# --- kafka mode: copy the values from your RDM Darwin Push Port subscription ---
# KAFKA_BROKERS=host1:9092,host2:9092
# KAFKA_TOPIC=
# KAFKA_GROUP_ID=
# KAFKA_USERNAME=
# KAFKA_PASSWORD=
# KAFKA_SASL_MECHANISM=scram-sha-512   # plain | scram-sha-256 | scram-sha-512

# Base data, loaded before the live feed starts (download from RDM / National Rail Open Data)
# DARWIN_REF_FILE=/data/darwin_ref.xml        # LocationRef: TIPLOC <-> CRS <-> name
# DARWIN_TIMETABLE_FILE=/data/darwin_tt.xml.gz  # today's full timetable (.gz ok)
